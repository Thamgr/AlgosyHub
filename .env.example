DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/algosyhub
SECRET_KEY=change-me-in-production

# Опционально: ключ/секрет для приватных CF API. Для штатного опроса
# публичных посылок через user.status — НЕ требуются.
CF_API_KEY=
CF_API_SECRET=

# Универсальный OpenAI-совместимый клиент. Подходит и для самого OpenAI,
# и для Yandex Cloud Foundation Models, и для любого другого
# совместимого провайдера — меняются только эти 4 переменные.
#
# Пример для OpenAI:
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=
#   OPENAI_PROJECT=
#
# Пример для Yandex Cloud (folder_id из консоли). Полный URI модели
# вида gpt://<folder>/<model> собирается автоматически:
#   OPENAI_API_KEY=AQVN...
#   OPENAI_MODEL=deepseek-v32/latest
#   OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1
#   OPENAI_PROJECT=b1g123456789
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_PROJECT=
