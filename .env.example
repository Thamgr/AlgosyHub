DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/algosyhub
SECRET_KEY=change-me-in-production

CF_SERVICE_ACCOUNT=
CF_SERVICE_PASSWORD=

# Альтернатива логин+пароль: открываем codeforces.com в браузере,
# логинимся, копируем заголовок Cookie (DevTools → Network → любой запрос
# → Request Headers → Cookie) и вставляем сюда. Используется когда
# Cloudflare блокирует программный POST /enter.
CF_SESSION_COOKIE=

CF_API_KEY=
CF_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
